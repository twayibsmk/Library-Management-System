# Copy this file to ".env" and fill in your values.
PORT=5000
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/library
# Or MongoDB Atlas, for example:
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/library
JWT_SECRET=change-this-to-any-long-random-text

# Library rules
LOAN_DAYS=14
FINE_PER_DAY=2
# Faculty pay no late fine by default. To charge them, uncomment:
# FINE_PER_DAY_FACULTY=1

# More library rules
MAX_BOOKS_STUDENT=3
MAX_BOOKS_FACULTY=5

# Email (needed for the registration verification code). Example with Gmail:
#   1. Turn on 2-step verification in your Google account
#   2. Create an "App password" (Google Account > Security > App passwords)
#   3. Fill in the lines below. Without SMTP_HOST the code is only printed in the terminal.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourlibrary@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM="Library <yourlibrary@gmail.com>"

# Optional: only allow college emails to register (comma separated)
# ALLOWED_EMAIL_DOMAINS=rgit.ac.in
